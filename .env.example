# Personal YAZIO credentials. Never commit real values.
YAZIO_USERNAME=
YAZIO_PASSWORD=

# Reverse-engineered application OAuth credentials. Required because YAZIO has
# no public developer API. Obtain them from your own authorized client traffic.
YAZIO_CLIENT_ID=
YAZIO_CLIENT_SECRET=

YAZIO_BASE_URL=https://yzapi.yazio.com/v20
YAZIO_TOKEN_CACHE_PATH=
NUTRITION_MCP_STATE_PATH=
NUTRITION_MCP_TIMEZONE=Europe/Moscow
YAZIO_PRODUCT_COUNTRIES=RU
YAZIO_PRODUCT_LOCALES=ru_RU
YAZIO_DEFAULT_SEX=male
YAZIO_HTTP_TIMEOUT_MS=15000

# Optional integration tests. Live write tests also require a safe product ID.
YAZIO_LIVE_TEST=0
YAZIO_LIVE_PRODUCT_ID=
