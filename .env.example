# Personal YAZIO credentials. Never commit real values.
YAZIO_USERNAME=
YAZIO_PASSWORD=

# Optional advanced override. The server includes the community-observed
# application credentials needed by the unofficial password grant. If YAZIO
# rotates them, override both values together; never configure only one.
# YAZIO_CLIENT_ID=
# YAZIO_CLIENT_SECRET=

YAZIO_BASE_URL=https://yzapi.yazio.com/v19
# YAZIO_TOKEN_CACHE_PATH=/absolute/path/to/token.json
# YAZIO_MCP_STATE_PATH=/absolute/path/to/state.json
YAZIO_MCP_TIMEZONE=UTC
YAZIO_PRODUCT_COUNTRIES=US
YAZIO_PRODUCT_LOCALES=en_US
YAZIO_DEFAULT_SEX=male
YAZIO_HTTP_TIMEOUT_MS=15000

# Optional integration tests. A write-test product is found automatically.
YAZIO_LIVE_TEST=0
# Optional overrides for deterministic product selection.
YAZIO_LIVE_PRODUCT_QUERY=apple
# YAZIO_LIVE_PRODUCT_ID=
